# OmniDev AI - Complete Environment Configuration Template
# Copy to .env and fill in your values
# NEVER commit actual .env file with secrets to version control

# ============================================================================
# Application Settings
# ============================================================================
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=change-me-in-production-generate-secure-random-key
JWT_SECRET=change-me-in-production-generate-secure-random-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# ============================================================================
# Backend API
# ============================================================================
API_PORT=8000
API_HOST=0.0.0.0
PYTHONUNBUFFERED=1

# ============================================================================
# Database Configuration
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=omnidev
DB_USER=user
DB_PASSWORD=password
DATABASE_URL=postgresql://user:password@localhost:5432/omnidev
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_URL=redis://localhost:6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_DEFAULT_TTL=3600
CACHE_MAX_SIZE=1000

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================================
# AI/LLM Configuration
# ============================================================================
OPENAI_API_KEY=sk-your-key-here
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=gpt-3.5-turbo

# ============================================================================
# RAG Configuration (Phase 8)
# ============================================================================
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_EMBEDDING_DIMENSION=384
RAG_TOP_K=5
RAG_MAX_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=50
RAG_VECTOR_STORE=faiss

# ============================================================================
# Agent Configuration (Phase 8)
# ============================================================================
AGENT_TIMEOUT_MS=30000
AGENT_MAX_RETRIES=3
AGENT_RESPONSE_SYNTHESIS=adaptive

# ============================================================================
# Memory Configuration (Phase 8)
# ============================================================================
MEMORY_RETENTION_DAYS=30
MEMORY_AUTO_CLEANUP=true
MEMORY_CLEANUP_INTERVAL_SECONDS=3600
MEMORY_STORAGE_BACKEND=postgres

# ============================================================================
# GitHub Integration
# ============================================================================
GITHUB_TOKEN=ghp_your-token-here
GITHUB_REPO_PREFIX=omnidev-

# ============================================================================
# Security
# ============================================================================
ACCESS_TOKEN_EXPIRE_MINUTES=30
SECURE_HTTPS_ONLY=false
SECURE_COOKIES=false

# ============================================================================
# Background Jobs (Phase 6)
# ============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ============================================================================
# Email Configuration
# ============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=OmniDev AI

# ============================================================================
# Monitoring & Metrics (Phase 9)
# ============================================================================
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
METRICS_COLLECTION_ENABLED=true

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# Feature Flags
# ============================================================================
FEATURE_MULTI_AGENT_ORCHESTRATION=true
FEATURE_RAG_SEARCH=true
FEATURE_REAL_TIME_COLLABORATION=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_BACKGROUND_JOBS=true

API_BASE_URL=http://192.168.1.x:8000
WEBSOCKET_URL=ws://192.168.1.x:8000/api/ws
CONNECTION_TIMEOUT=30

## Features

ENABLE_3D_UI=true
ENABLE_ANIMATIONS=true
ENABLE_WEBSOCKET=true
ENABLE_MEMORY_SYSTEM=true

## Performance

MAX_WORKERS=4
TASK_TIMEOUT=3600
CONCURRENT_TASKS=10
